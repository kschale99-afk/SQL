-- In this project I worked with a dataset called chinook, which represents a digital media store and includes tables for artists, albums, media tracks, invoices, and customers.

--I used SQL to perform the following queries:

--Which customers are not in the US?

SELECT firstname
, lastname
, customerid
, country
FROM chinook.customers
WHERE country <> 'US';

--Which customers are from Brazil?

SELECT firstname
, lastname
, customerid
, country
FROM chinook.customers
WHERE country = 'Brazil';

--What are the invoices of customers who are from Brazil?

SELECT customers.FirstName
, customers.LastName
, invoices.InvoiceId
, invoices.InvoiceDate
, invoices.BillingCountry
FROM invoices
LEFT JOIN customers
ON customers.CustomerId = invoices.CustomerId
WHERE invoices.BillingCountry = 'Brazil';


--Which Employees are Sales Agents?

SELECT *
FROM employees
WHERE title = 'Sales Support Agent';

--What are the unique/distinct list of billing countries from the Invoice table?

SELECT distinct billingcountry
FROM invoices;

--What are the invoices associated with each Sales Agent?

SELECT employees.FirstName
, employees.LastName
, employees.Title
, invoices.InvoiceId
FROM employees
    INNER JOIN customers
    ON employees.EmployeeId = customers.SupportRepId
        INNER JOIN invoices
        ON customers.CustomerId = invoices.CustomerId
;


--What are the invoice totals, customer names, countries, and sales agent names for all invoices and customers?

SELECT invoices.Total AS InvoiceTotal
, customers.FirstName AS CustFirstName
, customers.LastName AS CustLastName
, customers.Country
, employees.FirstName AS EmpFirstName
, employees.LastName AS EmpLastName
FROM employees
    FULL JOIN customers
    ON employees.EmployeeId = customers.SupportRepId
        FULL JOIN invoices
        ON customers.CustomerId = invoices.CustomerId
ORDER BY customers.LastName;

--How many invoices were there in 2009?

SELECT COUNT(invoiceid)
FROM invoices
WHERE invoicedate LIKE '2009%';


--What are the total sales for 2009?

SELECT  SUM(total)
FROM invoices
WHERE invoicedate LIKE '2009%';


--What is the purchased track name with each invoice line ID?

SELECT invoice_items.InvoiceLineId
, tracks.name
FROM invoice_items
    JOIN tracks
    ON invoice_items.TrackId = tracks.TrackId
;


--What is both the purchased track name and artist name with each invoice line ID?

SELECT invoice_items.InvoiceLineId
, tracks.name as 'SongName'
, artists.Name as 'ArtistName'
FROM invoice_items
    JOIN tracks
    ON invoice_items.TrackId = tracks.TrackId
        JOIN albums
        ON tracks.albumid = albums.AlbumId
            JOIN artists
            ON artists.ArtistId = albums.ArtistId
;

--What are all the tracks, album names, media types, and genre?

SELECT tracks.Name as SongName
, albums.Title as AlbumName
, media_types.Name as MediaType
, genres.Name as Genre
FROM tracks
    LEFT JOIN albums
    ON tracks.AlbumId = albums.AlbumId
        LEFT JOIN media_types
        ON tracks.MediaTypeId = media_types.MediaTypeId
            LEFT JOIN genres
            ON tracks.GenreId = genres.GenreId
;


--What are the total sales made by each sales agent?

SELECT SUM(invoices.Total)
, employees.LastName
, employees.FirstName
FROM invoices
    LEFT JOIN customers
        ON invoices.CustomerId = customers.CustomerId
            LEFT JOIN employees
                ON customers.SupportRepId = employees.EmployeeId
WHERE employees.Title LIKE '%agent'
GROUP BY employees.FirstName
;

--Which sales agent made the most dollars in sales in 2009? 

SELECT SUM(invoices.Total) AS TotalSales
, employees.LastName
, employees.FirstName
FROM invoices
LEFT JOIN customers
    ON invoices.CustomerId = customers.CustomerId
LEFT JOIN employees
    ON customers.SupportRepId = employees.EmployeeId
WHERE invoices.InvoiceDate LIKE '2009%'
  AND employees.Title LIKE '%Agent'
GROUP BY employees.LastName, employees.FirstName
ORDER BY TotalSales DESC
LIMIT 1;


-- Which artists have more than one album?

SELECT a.name
, COUNT(al.title) as TotalAlbums
FROM artists as a
    JOIN albums as al
    ON a.artistid = al.artistid
GROUP BY a.name
HAVING TotalAlbums > 1
ORDER BY TotalAlbums desc
;

-- How much did the company make in Q1 2009?

SELECT SUM(invoices.Total) as TotalSales
FROM invoices
WHERE invoicedate BETWEEN '2009-01-01 00:00' AND '2009-03-31 00:00';


-- What city and country contains the highest spenders (most revenue)?

SELECT billingcountry
, billingcity
, SUM(total) as TotalSales
FROM invoices
GROUP BY billingcountry, billingcity
ORDER BY TotalSales desc;

-- What artists are features on the Grunge playlist?

SELECT a.name as ArtistName
, p.name as PlaylistName
FROM playlists as p
    JOIN playlist_track as pt
    ON p.playlistid = pt.playlistid
        JOIN tracks as t
        ON pt.trackid = t.trackid
            JOIN albums as al
            ON t.albumid = al.albumid
                JOIN artists as a
                ON al.artistid = a.artistid
WHERE p.name = 'Grunge'
GROUP BY a.name;

--Which employees report to one another?

SELECT sub.lastname as LastName
, sub.firstname as FirstName
, sub.title as JobTitle
, boss.lastname as ReportsTo
, boss.firstname as ReportsTo
FROM employees as sub
    LEFT JOIN employees as boss
    ON sub.reportsto = boss.employeeid;

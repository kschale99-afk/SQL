SELECT * FROM Spotifydata;

--What is the average danceability by artist and track? 
SELECT artist_name, AVG(danceability)
FROM spotifydata
GROUP BY artist_name
ORDER BY artist_name;

--What artist released the longest song? 
SELECT MAX(duration_ms), artist_name, track_name
FROM spotifydata
GROUP BY track_name
ORDER BY duration_ms desc
LIMIT 1;

--Who are the top 10 artists based on popularity? 
SELECT MAX(popularity), artist_name
FROM spotifydata
GROUP BY artist_name
ORDER BY popularity desc
LIMIT 10;


--What's the average danceability for the 10 most popular songs?
SELECT AVG(danceability), track_name, artist_name
FROM spotifydata
GROUP BY danceability
ORDER BY AVG(danceability) desc
LIMIT 10;

--Which artists have more than one song?
SELECT artist_name, COUNT(track_name)
FROM spotifydata
GROUP BY artist_name 
HAVING COUNT(track_name) > 1
ORDER BY COUNT(track_name) desc;

--What are the top 10 songs for energy and danceability and their tempo?
SELECT MAX(energy) * 100 as energy_rating, MAX(danceability) * 100 as danceability_rating, tempo, track_name, artist_name
FROM spotifydata
GROUP BY track_name
ORDER BY MAX(danceability) desc
LIMIT 10
;